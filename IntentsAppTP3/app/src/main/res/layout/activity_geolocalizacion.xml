<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <EditText
            android:id="@+id/localizacionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingresá Localización aquí (ciudad, calle, coordenadas)"
            android:minLines="3"
            android:gravity="top"
            android:inputType="textMultiLine" />

        <Button
            android:id="@+id/buttonMapa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Localizar en el mapa" />

        <EditText
            android:id="@+id/etNumeroTelefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:hint="Ingresá número de teléfono"
            android:inputType="phone"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnMarcar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Marcar numero" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>